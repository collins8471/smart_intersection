         "cp /tmp/flows_cred.json /data/flows_cred.json && \
         sed -i \"s/<influx-api-token>/$(cat /run/secrets/influxdb2-admin-token)/g\" /data/flows_cred.json && \
-        bash /data/install_package.sh && \
         /usr/src/node-red/entrypoint.sh",
       ]
     restart: on-failure:5
@@ -213,6 +213,29 @@ services:
         target: certs/scenescape-ca.pem
     restart: on-failure:5
 
+  # dlstreamer-pipeline-server's built-in auto_start launches all enabled
+  # pipelines concurrently the instant it finishes booting, which races and
+  # reliably leaves every pipeline in an ERROR state. All pipelines in
+  # config.json have auto_start set to false; this one-shot container starts
+  # them sequentially over the REST API instead, so the fix survives
+  # restarts/reboots instead of relying on a manual REST call each time.
+  dlstreamer-pipeline-starter:
+    image: python:3.12
+    networks:
+      - scenescape
+    depends_on:
+      - dlstreamer-pipeline-server
+    environment:
+      - PIPELINE_SERVER_HOST=dlstreamer-pipeline-server
+      - PIPELINE_SERVER_PORT=8080
+      - AUTOSTART_PIPELINES=intersection-cam3,intersection-cam4,intersection-cam1-gpu,intersection-cam2-gpu
+      - AUTOSTART_STAGGER_SECONDS=5
+    volumes:
+      - ./${SAMPLE_APP}/src/dlstreamer-pipeline-server/config.json:/home/pipeline-server/config.json:ro
+      - ./${SAMPLE_APP}/src/dlstreamer-pipeline-server/start_pipelines.py:/start_pipelines.py:ro
+    entrypoint: ["python3", "/start_pipelines.py"]
+    restart: "no"
+
   pgserver:
     image: postgres:17.6
     env_file:
