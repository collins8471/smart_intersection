diff --git a/metro-ai-suite/metro-vision-ai-app-recipe/smart-intersection/src/dlstreamer-pipeline-server/start_pipelines.py b/metro-ai-suite/metro-vision-ai-app-recipe/smart-intersection/src/dlstreamer-pipeline-server/start_pipelines.py
new file mode 100644
index 00000000..14392c6b
--- /dev/null
+++ b/metro-ai-suite/metro-vision-ai-app-recipe/smart-intersection/src/dlstreamer-pipeline-server/start_pipelines.py
@@ -0,0 +1,76 @@
+#!/usr/bin/env python3
+# Starts the pipelines listed in AUTOSTART_PIPELINES one at a time, waiting
+# AUTOSTART_STAGGER_SECONDS between each. dlstreamer-pipeline-server's own
+# built-in auto_start launches all enabled pipelines concurrently right as it
+# finishes its slow model-loading boot, which reliably crashes every one of
+# them (the gvapython "datapublisher" callback races to open an MQTT
+# connection at the same instant and fails for all of them). Starting them
+# sequentially from outside avoids that race.
+import json
+import os
+import time
+import urllib.error
+import urllib.request
+
+HOST = os.environ.get("PIPELINE_SERVER_HOST", "dlstreamer-pipeline-server")
+PORT = os.environ.get("PIPELINE_SERVER_PORT", "8080")
+GROUP = "user_defined_pipelines"
+CONFIG_PATH = os.environ.get("PIPELINE_CONFIG_PATH", "/home/pipeline-server/config.json")
+STAGGER_SECONDS = float(os.environ.get("AUTOSTART_STAGGER_SECONDS", "5"))
+READY_TIMEOUT_SECONDS = float(os.environ.get("AUTOSTART_READY_TIMEOUT_SECONDS", "1800"))
+PIPELINE_NAMES = [n.strip() for n in os.environ.get("AUTOSTART_PIPELINES", "").split(",") if n.strip()]
+
+
+def wait_until_ready():
+    url = f"http://{HOST}:{PORT}/pipelines/status"
+    deadline = time.time() + READY_TIMEOUT_SECONDS
+    while time.time() < deadline:
+        try:
+            with urllib.request.urlopen(url, timeout=5) as resp:
+                if resp.status == 200:
+                    return
+        except (urllib.error.URLError, ConnectionError, TimeoutError):
+            pass
+        time.sleep(5)
+    raise TimeoutError(f"{url} did not become ready within {READY_TIMEOUT_SECONDS:.0f}s")
+
+
+def start_pipeline(version, payload):
+    url = f"http://{HOST}:{PORT}/pipelines/{GROUP}/{version}"
+    data = json.dumps(payload).encode()
+    req = urllib.request.Request(
+        url, data=data, headers={"Content-Type": "application/json"}, method="POST"
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=10) as resp:
+            print(f"[{version}] started: HTTP {resp.status}", flush=True)
+    except urllib.error.HTTPError as e:
+        print(f"[{version}] failed to start: HTTP {e.code} {e.read().decode(errors='replace')}", flush=True)
+    except Exception as e:
+        print(f"[{version}] failed to start: {e}", flush=True)
+
+
+def main():
+    if not PIPELINE_NAMES:
+        print("AUTOSTART_PIPELINES is empty, nothing to start", flush=True)
+        return
+
+    print("Waiting for dlstreamer-pipeline-server REST API...", flush=True)
+    wait_until_ready()
+
+    with open(CONFIG_PATH) as f:
+        cfg = json.load(f)
+    pipelines_by_name = {p["name"]: p for p in cfg["config"]["pipelines"]}
+
+    for i, name in enumerate(PIPELINE_NAMES):
+        pipeline = pipelines_by_name.get(name)
+        if pipeline is None:
+            print(f"[{name}] not found in {CONFIG_PATH}, skipping", flush=True)
+            continue
+        start_pipeline(name, pipeline.get("payload", {}))
+        if i < len(PIPELINE_NAMES) - 1:
+            time.sleep(STAGGER_SECONDS)
+
+
+if __name__ == "__main__":
+    main()
